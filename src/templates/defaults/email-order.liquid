{%- comment -%}
  The confirmation a buyer gets after ordering from your online store.
  order.items lists what they bought; order.payment_lines say how to pay (from your store settings);
  order.delivery is true for delivery, false for pickup.
{% endcomment -%}
<!doctype html>
<html lang="en">
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#0f1117">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:32px 12px">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #e6e8ec;border-radius:14px">
        <tr><td style="padding:28px 32px 6px">
          {%- if store.logo %}
          <img src="{{ store.logo }}" alt="{{ store.name }}" height="40" style="display:block;height:40px;width:auto;max-width:220px;border:0;margin:0 0 14px">
          {%- else %}
          <div style="font-size:13px;color:#646b7b">{{ store.name }}</div>
          {%- endif %}
          <h1 style="margin:6px 0 0;font-size:22px;line-height:1.25;letter-spacing:-0.02em">Order #{{ order.number }}</h1>
        </td></tr>
        <tr><td style="padding:14px 32px 4px;font-size:15px;line-height:1.6">
          <p style="margin:0 0 14px">Thank you, {{ order.customer_name }}. {{ store.name }} has your order #{{ order.number }}.</p>
        </td></tr>
        <tr><td style="padding:4px 32px 8px">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e6e8ec;border-radius:10px;font-size:14px">
            {%- for item in order.items %}
            <tr>
              <td style="padding:10px 14px;{% unless forloop.first %}border-top:1px solid #eef0f3;{% endunless %}">{{ item.quantity }} × {{ item.name }}{% if item.variant %} <span style="color:#646b7b">({{ item.variant }})</span>{% endif %}</td>
              <td align="right" style="padding:10px 14px;{% unless forloop.first %}border-top:1px solid #eef0f3;{% endunless %}">{{ item.total | money }}</td>
            </tr>
            {%- endfor %}
            <tr>
              <td style="padding:12px 14px;border-top:1px solid #e6e8ec;background:#f8f9fa;font-weight:600">Total</td>
              <td align="right" style="padding:12px 14px;border-top:1px solid #e6e8ec;background:#f8f9fa;font-size:18px;font-weight:700">{{ order.total | money }}</td>
            </tr>
          </table>
        </td></tr>
        <tr><td style="padding:14px 32px 4px;font-size:14px;line-height:1.6;color:#3d4250">
          {%- for line in order.payment_lines %}<p style="margin:0 0 8px;white-space:pre-line">{{ line }}</p>{% endfor %}
          <p style="margin:0 0 8px">{% if order.delivery %}Delivery to {{ order.address }}.{% else %}Pickup at {{ store.name }}{% if store.city %}, {{ store.city }}{% endif %}.{% endif %}</p>
        </td></tr>
        {%- if order.url %}
        <tr><td style="padding:8px 32px 4px">
          <a href="{{ order.url }}" style="display:inline-block;background:#6d2d93;color:#ffffff;padding:12px 22px;border-radius:9px;text-decoration:none;font-weight:600;font-size:15px">Follow your order and get your receipt</a>
        </td></tr>
        {%- endif %}
        <tr><td style="padding:22px 32px 28px;font-size:12px;line-height:1.6;color:#646b7b">
          Your receipt, authorized by the Belize Tax Service, will be on that page once the payment is confirmed.<br>
          {{ store.name }}{% if store.telephone %} · {{ store.telephone }}{% endif %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
