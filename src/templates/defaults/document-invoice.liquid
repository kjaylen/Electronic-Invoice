{%- comment -%}
  The printed copy of tax invoices, debit notes and credit notes (A4).
  BTS allows only what is in the signed document (the document object) plus your own message.
  {% bts %} prints what BTS requires on every copy: the QR code, the ETDUI, the authorization and
  the legal notices. Keep it. BTS also asks for at least 11 pt type for the parties, items and
  amounts, and at least 9 pt everywhere else.
{% endcomment -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ document.type_name }} {{ document.number_display }}</title>
<style>
  @page { size: A4; margin: 14mm 14mm 16mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11pt; line-height: 1.4; color: #14161b; }
  .top { display: flex; justify-content: space-between; gap: 12mm; padding-bottom: 6mm; border-bottom: 1.5pt solid #14161b; }
  .logo { display: block; max-width: 60mm; max-height: 20mm; margin-bottom: 3mm; }
  .issuer-name { font-size: 15pt; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 1mm; }
  .muted { color: #5b6170; }
  .small { font-size: 9pt; }
  .title { text-align: right; }
  .type { font-size: 20pt; font-weight: 700; letter-spacing: -0.02em; text-transform: uppercase; line-height: 1.1; }
  .number { margin-top: 2mm; }
  .parties { display: flex; gap: 12mm; padding: 6mm 0 4mm; }
  .party { flex: 1; }
  .label { font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #5b6170; margin-bottom: 1.5mm; }
  .strong { font-weight: 700; }
  table.lines { width: 100%; border-collapse: collapse; margin-top: 2mm; }
  .lines th { font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #5b6170; text-align: left; padding: 2mm; border-bottom: 1pt solid #14161b; }
  .lines td { padding: 2.5mm 2mm; border-bottom: 0.5pt solid #d9dce2; vertical-align: top; }
  .r { text-align: right; white-space: nowrap; }
  .adj { font-size: 9pt; color: #5b6170; margin-top: 0.5mm; }
  .bottom { display: flex; justify-content: space-between; gap: 10mm; margin-top: 7mm; align-items: flex-start; page-break-inside: avoid; }
  table.totals { width: 78mm; border-collapse: collapse; flex: none; }
  .totals td { padding: 1.4mm 0; }
  .totals .grand td { border-top: 1.5pt solid #14161b; padding-top: 2.5mm; font-size: 14pt; font-weight: 700; }
  .notes { margin-top: 6mm; font-size: 9.5pt; color: #3d4250; }
  .message { margin-top: 6mm; padding-top: 3mm; border-top: 0.5pt solid #d9dce2; font-size: 9.5pt; text-align: center; color: #3d4250; }
</style>
</head>
<body>
  <div class="top">
    <div>
      {%- if business.logo %}<img class="logo" src="{{ business.logo }}" alt="{{ document.issuer.name }}">{% endif %}
      <div class="issuer-name">{{ document.issuer.name }}</div>
      {%- if document.issuer.tin %}<div>TIN {{ document.issuer.tin }}</div>{% endif %}
      {%- for line in document.issuer.address_lines %}<div>{{ line }}</div>{% endfor %}
      {%- if document.issuer.telephone or document.issuer.email %}
      <div class="muted small">{{ document.issuer.telephone }}{% if document.issuer.telephone and document.issuer.email %} · {% endif %}{{ document.issuer.email }}</div>
      {%- endif %}
    </div>
    <div class="title">
      <div class="type">{{ document.type_name }}</div>
      <div class="number">No. {{ document.number }} · Series {{ document.series }}</div>
      <div class="muted">{{ document.issue_date | date: '%B %-d, %Y' }} · {{ document.issue_time }}</div>
    </div>
  </div>

  <div class="parties">
    <div class="party">
      <div class="label">Customer</div>
      {%- if document.customer %}
        {%- if document.customer.name %}<div class="strong">{{ document.customer.name }}</div>{% endif %}
        {%- if document.customer.tin %}<div>TIN {{ document.customer.tin }}</div>{% endif %}
        {%- if document.customer.other_id %}<div>{{ document.customer.other_id }}</div>{% endif %}
        {%- for line in document.customer.address_lines %}<div>{{ line }}</div>{% endfor %}
      {%- else %}
        <div class="muted">Walk-in customer</div>
      {%- endif %}
    </div>
    {%- if document.payment.due_date or document.payment.terms %}
    <div class="party">
      <div class="label">Payment</div>
      {%- if document.payment.due_date %}<div>Due {{ document.payment.due_date | date: '%B %-d, %Y' }}</div>{% endif %}
      {%- if document.payment.terms %}<div>{{ document.payment.terms }}</div>{% endif %}
    </div>
    {%- endif %}
  </div>

  <table class="lines">
    <thead>
      <tr><th>#</th><th>Description</th><th class="r">Quantity</th><th class="r">Unit price</th><th class="r">Net</th><th class="r">Tax</th><th class="r">Total</th></tr>
    </thead>
    <tbody>
      {%- for line in document.lines %}
      <tr>
        <td>{{ line.number }}</td>
        <td>
          {{ line.description }}{% if line.code %} <span class="muted small">{{ line.code }}</span>{% endif %}
          {%- for a in line.adjustments %}<div class="adj">{{ a.reason }}: {% if a.is_charge %}+{% else %}−{% endif %}{{ a.amount | amount }}</div>{% endfor %}
        </td>
        <td class="r">{{ line.quantity }} {{ line.unit_code }}</td>
        <td class="r">{{ line.unit_price | amount }}</td>
        <td class="r">{{ line.net | amount }}</td>
        <td class="r">{{ line.tax | amount }}</td>
        <td class="r">{{ line.total | amount }}</td>
      </tr>
      {%- endfor %}
    </tbody>
  </table>

  <div class="bottom">
    <div>{% bts %}</div>
    <table class="totals">
      <tr><td>Price (excl. taxes)</td><td class="r">{{ document.totals.tax_exclusive | amount }}</td></tr>
      {%- for tax in document.totals.other_taxes %}<tr><td>{{ tax.name }}</td><td class="r">{{ tax.amount | amount }}</td></tr>{% endfor %}
      <tr><td>GST</td><td class="r">{{ document.totals.gst | amount }}</td></tr>
      <tr class="grand"><td>Total BZD</td><td class="r">{{ document.totals.tax_inclusive | amount }}</td></tr>
      {%- if document.totals.prepaid %}<tr><td>Prepaid</td><td class="r">{{ document.totals.prepaid | amount }}</td></tr>{% endif %}
      {%- if document.totals.payable != document.totals.tax_inclusive %}<tr class="grand"><td>Amount due</td><td class="r">{{ document.totals.payable | amount }}</td></tr>{% endif %}
    </table>
  </div>

  {%- if document.note %}<div class="notes">{{ document.note }}</div>{% endif %}
  {%- if message %}<div class="message">{{ message }}</div>{% endif %}
</body>
</html>
