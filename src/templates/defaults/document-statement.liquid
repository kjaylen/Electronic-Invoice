{%- comment -%}
  A customer's statement of account (A4): what is still owed and the recent payments.
{% endcomment -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Statement of account</title>
<style>
  @page { size: A4; margin: 16mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10.5pt; line-height: 1.45; color: #14161b; }
  .top { display: flex; justify-content: space-between; gap: 12mm; padding-bottom: 6mm; border-bottom: 1.5pt solid #14161b; }
  .logo { display: block; max-width: 60mm; max-height: 20mm; margin-bottom: 3mm; }
  .name { font-size: 15pt; font-weight: 700; }
  .muted { color: #5b6170; }
  .title { text-align: right; }
  .type { font-size: 20pt; font-weight: 700; letter-spacing: -0.02em; }
  .label { font-size: 8.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #5b6170; margin: 7mm 0 2mm; }
  table { width: 100%; border-collapse: collapse; }
  th { font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.05em; color: #5b6170; text-align: left; padding: 2mm; border-bottom: 1pt solid #14161b; }
  td { padding: 2.2mm 2mm; border-bottom: 0.5pt solid #d9dce2; }
  .r { text-align: right; white-space: nowrap; }
  .late { color: #b42318; }
  .due { display: flex; gap: 10mm; margin-top: 6mm; }
  .due div { padding: 4mm 5mm; border: 1pt solid #d9dce2; border-radius: 2mm; min-width: 50mm; }
  .due strong { display: block; font-size: 15pt; }
  .note { margin-top: 8mm; font-size: 9.5pt; color: #3d4250; white-space: pre-line; }
</style>
</head>
<body>
  <div class="top">
    <div>
      {%- if business.logo %}<img class="logo" src="{{ business.logo }}" alt="{{ business.name }}">{% endif %}
      <div class="name">{{ business.name }}</div>
      <div>TIN {{ business.tin }}</div>
      {%- for line in business.address_lines %}<div>{{ line }}</div>{% endfor %}
      <div class="muted">{{ business.telephone }}{% if business.telephone and business.email %} · {% endif %}{{ business.email }}</div>
    </div>
    <div class="title">
      <div class="type">Statement of account</div>
      <div class="muted">As of {{ statement.as_of | date: '%B %-d, %Y' }}</div>
    </div>
  </div>

  <div class="label">Customer</div>
  <div><strong>{{ customer.name }}</strong>{% if customer.tin %} · TIN {{ customer.tin }}{% endif %}</div>

  <div class="due">
    <div><span class="muted">Total due</span><strong>{{ statement.total_due | money }}</strong></div>
    <div><span class="muted">Overdue</span><strong{% if statement.overdue != '0.00' %} class="late"{% endif %}>{{ statement.overdue | money }}</strong></div>
  </div>

  <div class="label">Open invoices</div>
  <table>
    <thead><tr><th>Document</th><th>Date</th><th>Due</th><th class="r">Total</th><th class="r">Paid</th><th class="r">Balance</th></tr></thead>
    <tbody>
      {%- for item in statement.open %}
      <tr>
        <td>{{ item.type }} {{ item.number }}</td>
        <td>{{ item.issue_date }}</td>
        <td{% if item.days_overdue > 0 %} class="late"{% endif %}>{{ item.due_date }}{% if item.days_overdue > 0 %} ({{ item.days_overdue }} d){% endif %}</td>
        <td class="r">{{ item.total | amount }}</td>
        <td class="r">{{ item.paid | amount }}</td>
        <td class="r"><strong>{{ item.balance | amount }}</strong></td>
      </tr>
      {%- else %}
      <tr><td colspan="6" class="muted">Nothing is owed.</td></tr>
      {%- endfor %}
    </tbody>
  </table>

  {%- if statement.payments.size > 0 %}
  <div class="label">Recent payments</div>
  <table>
    <thead><tr><th>Date</th><th>For</th><th>Method</th><th class="r">Amount</th></tr></thead>
    <tbody>
      {%- for p in statement.payments %}
      <tr><td>{{ p.paid_on }}</td><td>{{ p.number }}</td><td>{{ p.method }}{% if p.reference %} · {{ p.reference }}{% endif %}</td><td class="r">{{ p.amount | amount }}</td></tr>
      {%- endfor %}
    </tbody>
  </table>
  {%- endif %}

  {%- if statement.note %}<div class="note">{{ statement.note }}</div>{% endif %}
  {%- if pay_url %}<div class="note">Pay online: {{ pay_url }}</div>{% endif %}
</body>
</html>
