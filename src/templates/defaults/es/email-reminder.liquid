{%- comment -%}
  Un recordatorio de pago de una factura (la factura va adjunta).
  reminder.when es "before" (antes del vencimiento), "due" (hoy) o "after" (vencida);
  reminder.days es cuántos días antes o después; reminder.what dice "factura 001-000000042".
  message trae sus instrucciones de pago (Cobros, Ajustes).
{% endcomment -%}
<!doctype html>
<html lang="es">
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#0f1117">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:32px 12px">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #e6e8ec;border-radius:14px">
        <tr><td style="padding:28px 32px 6px">
          {%- if business.logo %}
          <img src="{{ business.logo }}" alt="{{ business.name }}" height="40" style="display:block;height:40px;width:auto;max-width:220px;border:0;margin:0 0 14px">
          {%- else %}
          <div style="font-size:13px;color:#646b7b">{{ business.name }}</div>
          {%- endif %}
          <h1 style="margin:6px 0 0;font-size:22px;line-height:1.25;letter-spacing:-0.02em">
            {%- case reminder.when -%}
              {%- when 'after' -%}Pago vencido
              {%- when 'due' -%}El pago vence hoy
              {%- else -%}Pago próximo a vencer
            {%- endcase -%}
          </h1>
        </td></tr>
        <tr><td style="padding:14px 32px 4px;font-size:15px;line-height:1.6">
          <p style="margin:0 0 14px">Hola{% if customer.name %} {{ customer.name }}{% endif %}:</p>
          {%- case reminder.when %}
          {%- when 'after' %}
          <p style="margin:0 0 14px">Según nuestros registros, la {{ reminder.what }} vencía el {{ document.due_date | date: '%-d de %B de %Y' }} y aún hay {{ reminder.balance | money }} pendientes ({{ reminder.days }} {{ reminder.days | pluralize: 'día', 'días' }} de atraso).</p>
          <p style="margin:0 0 14px">Si ya pagó, gracias, y por favor ignore este mensaje.</p>
          {%- when 'due' %}
          <p style="margin:0 0 14px">Le recordamos que la {{ reminder.what }} vence hoy.</p>
          <p style="margin:0 0 14px">Monto a pagar: <strong>{{ reminder.balance | money }}</strong>.</p>
          {%- else %}
          <p style="margin:0 0 14px">Le recordamos que la {{ reminder.what }} por {{ document.total | money }} vence el {{ document.due_date | date: '%-d de %B de %Y' }}.</p>
          <p style="margin:0 0 14px">Monto a pagar: <strong>{{ reminder.balance | money }}</strong>.</p>
          {%- endcase %}
          {%- if message %}<p style="margin:0 0 14px;white-space:pre-line">{{ message }}</p>{% endif %}
        </td></tr>
        {%- if pay_url %}
        <tr><td style="padding:8px 32px 4px">
          <a href="{{ pay_url }}" style="display:inline-block;background:#6d2d93;color:#ffffff;padding:12px 22px;border-radius:9px;text-decoration:none;font-weight:600;font-size:15px">Pagar en línea</a>
        </td></tr>
        {%- endif %}
        <tr><td style="padding:22px 32px 28px;font-size:12px;line-height:1.6;color:#646b7b">
          El PDF es la copia impresa. El archivo XML es el documento tributario electrónico autorizado por el Belize Tax Service.<br>
          {{ business.name }}{% if business.telephone %} · {{ business.telephone }}{% endif %}{% if business.email %} · {{ business.email }}{% endif %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
