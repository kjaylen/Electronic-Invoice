{%- comment -%}
  A customer's statement of account (the statement PDF is attached).
  statement.open lists what is still owed: label ("Invoice 001-000000042"), balance, due_date,
  days_overdue and pay_url (a link to pay that invoice, when you take payments online).
  statement.note holds your payment instructions.
{% endcomment -%}
<!doctype html>
<html lang="en">
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#0f1117">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:32px 12px">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #e6e8ec;border-radius:14px">
        <tr><td style="padding:28px 32px 6px">
          {%- if business.logo %}
          <img src="{{ business.logo }}" alt="{{ business.name }}" height="40" style="display:block;height:40px;width:auto;max-width:220px;border:0;margin:0 0 14px">
          {%- else %}
          <div style="font-size:13px;color:#646b7b">{{ business.name }}</div>
          {%- endif %}
          <h1 style="margin:6px 0 0;font-size:22px;line-height:1.25;letter-spacing:-0.02em">Statement of account</h1>
        </td></tr>
        <tr><td style="padding:14px 32px 4px;font-size:15px;line-height:1.6">
          <p style="margin:0 0 14px">Please find attached your statement of account from {{ business.name }} as of {{ statement.as_of | date: '%-d %b %Y' }}.</p>
          {%- if statement.open.size > 0 %}
          <p style="margin:0 0 14px">Total due: <strong>{{ statement.total_due | money }}</strong>{% if statement.overdue != '0.00' %}, of which {{ statement.overdue | money }} is overdue{% endif %}.</p>
          {%- else %}
          <p style="margin:0 0 14px">You have nothing to pay. Thank you.</p>
          {%- endif %}
        </td></tr>
        {%- if statement.open.size > 0 %}
        <tr><td style="padding:4px 32px 8px">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e6e8ec;border-radius:10px;font-size:14px">
            {%- for item in statement.open %}
            <tr><td style="padding:10px 14px;{% unless forloop.first %}border-top:1px solid #eef0f3;{% endunless %}">
              <p style="margin:0">{{ item.label }}: {{ item.balance | money }}, due {{ item.due_date | date: '%-d %b %Y' }}{% if item.days_overdue > 0 %} ({{ item.days_overdue }} days overdue){% endif %}{% if item.pay_url %}. Pay online: <a href="{{ item.pay_url }}" style="color:#6d2d93">{{ item.pay_url }}</a>{% endif %}</p>
            </td></tr>
            {%- endfor %}
          </table>
        </td></tr>
        {%- endif %}
        {%- if statement.note %}
        <tr><td style="padding:10px 32px 4px;font-size:14px;line-height:1.6;color:#3d4250"><p style="margin:0;white-space:pre-line">{{ statement.note }}</p></td></tr>
        {%- endif %}
        <tr><td style="padding:22px 32px 28px;font-size:12px;line-height:1.6;color:#646b7b">
          {{ business.name }}{% if business.telephone %} · {{ business.telephone }}{% endif %}{% if business.email %} · {{ business.email }}{% endif %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
