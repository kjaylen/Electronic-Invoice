{%- comment -%}
  The email that goes with an invoice, receipt, credit or debit note.
  The printed copy (PDF) and the signed XML are attached for you.
  Try: business.name, customer.name, document.number_display, document.total | money, message, pay_url.
  intro holds opening lines when the app writes its own (an invoice from a quote, a payment request).
{% endcomment -%}
<!doctype html>
<html lang="en">
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#0f1117">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:32px 12px">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #e6e8ec;border-radius:14px">
        <tr><td style="padding:28px 32px 6px">
          {%- if business.logo %}
          <img src="{{ business.logo }}" alt="{{ business.name }}" height="40" style="display:block;height:40px;width:auto;max-width:220px;border:0;margin:0 0 14px">
          {%- else %}
          <div style="font-size:13px;color:#646b7b">{{ business.name }}</div>
          {%- endif %}
          <h1 style="margin:6px 0 0;font-size:22px;line-height:1.25;letter-spacing:-0.02em">{{ document.type_name }} {{ document.number_display }}</h1>
        </td></tr>
        <tr><td style="padding:14px 32px 4px;font-size:15px;line-height:1.6">
          <p style="margin:0 0 14px">Hello{% if customer.name %} {{ customer.name }}{% endif %},</p>
          {%- if intro.size > 0 %}
            {%- for line in intro %}<p style="margin:0 0 14px">{{ line }}</p>{% endfor %}
          {%- else %}
          <p style="margin:0 0 14px">Please find attached {{ document.type_name | downcase }} {{ document.number_display }} from {{ business.name }}.</p>
          {%- endif %}
          {%- if message %}
          <p style="margin:0 0 14px;white-space:pre-line">{{ message }}</p>
          {%- endif %}
        </td></tr>
        <tr><td style="padding:4px 32px 8px">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8f9fa;border:1px solid #e6e8ec;border-radius:10px">
            <tr>
              <td style="padding:14px 16px 6px;font-size:13px;color:#646b7b">Date</td>
              <td align="right" style="padding:14px 16px 6px;font-size:14px">{{ document.issue_date | date: '%B %-d, %Y' }}</td>
            </tr>
            {%- if document.due_date %}
            <tr>
              <td style="padding:0 16px 6px;font-size:13px;color:#646b7b">Due</td>
              <td align="right" style="padding:0 16px 6px;font-size:14px">{{ document.due_date | date: '%B %-d, %Y' }}</td>
            </tr>
            {%- endif %}
            <tr>
              <td style="padding:12px 16px 14px;border-top:1px solid #e6e8ec;font-size:14px;font-weight:600">Total</td>
              <td align="right" style="padding:12px 16px 14px;border-top:1px solid #e6e8ec;font-size:19px;font-weight:700">{{ document.total | money }}</td>
            </tr>
          </table>
        </td></tr>
        {%- if pay_url %}
        <tr><td style="padding:18px 32px 4px">
          <a href="{{ pay_url }}" style="display:inline-block;background:#6d2d93;color:#ffffff;padding:12px 22px;border-radius:9px;text-decoration:none;font-weight:600;font-size:15px">Pay online</a>
        </td></tr>
        {%- endif %}
        <tr><td style="padding:22px 32px 28px;font-size:12px;line-height:1.6;color:#646b7b">
          The PDF is the printed copy. The XML file is the electronic tax document as authorized by the Belize Tax Service.<br>
          {{ business.name }}{% if business.telephone %} · {{ business.telephone }}{% endif %}{% if business.email %} · {{ business.email }}{% endif %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
