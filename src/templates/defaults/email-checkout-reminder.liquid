{%- comment -%}
  Sent to a buyer who gave their email at checkout and left without ordering.
  Keep the unsubscribe link: buyers must be able to stop these emails.
{% endcomment -%}
<!doctype html>
<html lang="en">
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#0f1117">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:32px 12px">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #e6e8ec;border-radius:14px">
        <tr><td style="padding:28px 32px 6px">
          {%- if store.logo %}
          <img src="{{ store.logo }}" alt="{{ store.name }}" height="40" style="display:block;height:40px;width:auto;max-width:220px;border:0;margin:0 0 14px">
          {%- else %}
          <div style="font-size:13px;color:#646b7b">{{ store.name }}</div>
          {%- endif %}
          <h1 style="margin:6px 0 0;font-size:22px;line-height:1.25;letter-spacing:-0.02em">{% if reminder.number == 1 %}Your cart is waiting{% else %}Still thinking it over?{% endif %}</h1>
        </td></tr>
        <tr><td style="padding:14px 32px 4px;font-size:15px;line-height:1.6">
          <p style="margin:0 0 14px">{% if buyer.name != blank %}Hello {{ buyer.name }}, you{% else %}You{% endif %} left these in your cart at {{ store.name }}. We kept them for you: pick up where you left off.</p>
        </td></tr>
        <tr><td style="padding:4px 32px">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #e6e8ec;font-size:14px">
            {%- for item in items %}
            <tr>
              <td style="padding:10px 0;border-bottom:1px solid #e6e8ec">{{ item.title }}{% if item.variant %} <span style="color:#646b7b">({{ item.variant }})</span>{% endif %}{% if item.quantity > 1 %} <span style="color:#646b7b">× {{ item.quantity }}</span>{% endif %}</td>
              <td align="right" style="padding:10px 0;border-bottom:1px solid #e6e8ec;white-space:nowrap">{{ item.total | money }}</td>
            </tr>
            {%- endfor %}
            {%- if total %}
            <tr><td style="padding:10px 0;font-weight:600">Total</td><td align="right" style="padding:10px 0;font-weight:600;white-space:nowrap">{{ total | money }}</td></tr>
            {%- endif %}
          </table>
        </td></tr>
        <tr><td style="padding:18px 32px 4px">
          <a href="{{ url }}" style="display:inline-block;background:#6d2d93;color:#ffffff;padding:12px 22px;border-radius:9px;text-decoration:none;font-weight:600;font-size:15px">Finish your order</a>
        </td></tr>
        <tr><td style="padding:14px 32px 0;font-size:14px;line-height:1.6;color:#3d4250">
          Prices and stock are those of today, and may change. Questions? {% if store.telephone %}Call us on {{ store.telephone }}, or reply{% else %}Reply{% endif %} to this email.
        </td></tr>
        <tr><td style="padding:22px 32px 28px;font-size:12px;line-height:1.6;color:#646b7b">
          {{ store.name }}{% if store.city %} · {{ store.city }}{% endif %}. You get this because you started an order at our store{% if reminder.last %}; it is the last reminder{% endif %}. <a href="{{ unsubscribe_url }}" style="color:#646b7b">Stop these emails</a>.
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
