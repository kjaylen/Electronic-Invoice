{
  "name": "floreo",
  "version": "0.1.0",
  "private": true,
  "description": "Belize e-invoicing core engine: builds, signs and submits Electronic Tax Documents to the Belize Tax Service.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "check": "npm run typecheck && npm test",
    "example": "node --disable-warning=ExperimentalWarning scripts/example.ts",
    "test-certs": "bash scripts/make-test-certs.sh",
    "example:pdf": "node --disable-warning=ExperimentalWarning scripts/example-pdf.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "icons": "node --disable-warning=ExperimentalWarning scripts/make-icons.ts",
    "e2e": "npm run web:build && playwright test",
    "platform-admin": "node --disable-warning=ExperimentalWarning scripts/platform-admin.ts",
    "rotate-keys": "node --disable-warning=ExperimentalWarning scripts/rotate-keys.ts",
    "move-photos": "node --disable-warning=ExperimentalWarning scripts/move-photos.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "xmllint-wasm": "^5.3.0"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-liquid": "6.3.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fastify/static": "^10.1.12",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.12",
    "@xmldom/xmldom": "^0.9.12",
    "codemirror": "6.0.2",
    "fastify": "^5.12.8",
    "jsbarcode": "3.11.6",
    "liquidjs": "10.30.1",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "playwright-core": "1.65.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "sanitize-html": "2.18.2",
    "three": "^0.187.0",
    "xml-crypto": "^6.4.0"
  }
}
