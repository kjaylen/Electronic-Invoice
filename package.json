{
  "name": "belize-einvoicing",
  "version": "0.1.0",
  "private": true,
  "description": "Belize e-invoicing core engine: builds, signs and submits Electronic Tax Documents to the Belize Tax Service.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "example": "node --disable-warning=ExperimentalWarning scripts/example.ts",
    "test-certs": "bash scripts/make-test-certs.sh",
    "example:pdf": "node --disable-warning=ExperimentalWarning scripts/example-pdf.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "xmllint-wasm": "^5.3.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fastify": "^5.12.8",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.4.0"
  }
}
