{
  "name": "floreo-till",
  "productName": "Floreo Till",
  "version": "1.0.0",
  "private": true,
  "description": "The till for Windows, macOS and Linux: sell, print receipts on network and USB receipt printers, open the cash drawer, show the customer the total.",
  "main": "main.cjs",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "start": "npm run web && electron .",
    "dev": "node scripts/dev.mjs",
    "smoke": "npm run web && node scripts/smoke.mjs",
    "dist": "npm run web && electron-builder --config electron-builder.config.cjs",
    "dist:win": "npm run web && electron-builder --config electron-builder.config.cjs --win",
    "dist:mac": "npm run web && electron-builder --config electron-builder.config.cjs --mac",
    "dist:linux": "npm run web && electron-builder --config electron-builder.config.cjs --linux",
    "publish-local": "node scripts/publish-local.mjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
