# Settings for a deployed server (production or staging). Copy to a file that is
# NOT committed (for example deploy/.env.production) and fill it in.
# Generate secrets with: openssl rand -base64 32

# ---------- required ----------
DATABASE_URL=postgres://einvoicing:CHANGE_ME@db:5432/einvoicing
# Encrypts certificate keys and two-step secrets. Losing it means re-installing every
# business's certificate. Keep a copy in your password manager or key service.
KEY_ENCRYPTION_KEY=
PUBLIC_URL=https://app.example.bz
MAIL_FROM=Floreo <no-reply@example.bz>
SMTP_URL=smtps://user:password@smtp.example.com:465

# ---------- BTS ----------
# Leave unset for BTS's own endpoints; set for a stand-in during staging tests.
# BTS_BASE_URL=
# BTS_CA_FILE=/run/secrets/bts-ca.pem

# ---------- operations ----------
DEPLOY_ENVIRONMENT=production
# Operations alerts (worker stopped, documents stuck, certificates expired): Slack/Teams/Discord webhook.
ALERT_WEBHOOK_URL=
# Enables GET /metrics for Prometheus with "Authorization: Bearer <token>" (32+ characters).
METRICS_TOKEN=
# Run the background worker and housekeeping in ONE process only when you scale out:
# set both to 0 on the others.
WORKER_INTERVAL_MS=60000
HOUSEKEEPING_INTERVAL_MS=300000

# ---------- product photos (S3-compatible storage + CDN) ----------
# S3_BUCKET=floreo-photos
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://photos.example.bz

# ---------- the platform's own billing ----------
# Address of the platform's own business on the platform: it issues subscribers' e-invoices.
# PLATFORM_BILLING_TENANT=altiora
# PLATFORM_PAYMENT_INSTRUCTIONS=Belize Bank, account 000-000-000, name Altiora Technologies Use your TIN as the reference.

# ---------- integrations and stores ----------
# The platform's Intuit app (QuickBooks Online); register <PUBLIC_URL>/v1/integrations/quickbooks/callback with Intuit.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_ENVIRONMENT=production
# Businesses point their store domains here (CNAME); serve it with on-demand TLS (docs/operations.md).
# STORE_DOMAIN_TARGET=stores.example.bz
# E-Kyash's API addresses, given by Belize Bank (the same for every merchant). Without them E-Kyash is not offered.
# EKYASH_SANDBOX_URL=
# EKYASH_LIVE_URL=
# API_RATE_LIMIT_PER_MINUTE=600

# ---------- public pages ----------
# LEGAL_NAME=Altiora Technologies
# CONTACT_EMAIL=hello@example.bz

# ---------- key rotation (only while rotating; see docs/operations.md) ----------
# KEY_ENCRYPTION_KEYS_PREVIOUS=

# ---------- other ----------
# ALLOW_SIGNUP=true
# ADMIN_TOKEN=
